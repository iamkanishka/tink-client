{
  "name": "tink-client",
  "version": "2.0.0",
  "description": "Production-ready TypeScript SDK for the Tink Open Banking API. Zero dependencies. Full coverage of OAuth, accounts, transactions, enrichment, providers, categories, statistics, users, investments, loans, budgets, cash flow, financial calendar, account check, balance check, income check, expense check, risk insights, risk categorisation, business account check, connector, Tink Link URL builder, connectivity, identities, and webhooks.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "npx rimraf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "keywords": [
    "tink",
    "open-banking",
    "psd2",
    "fintech",
    "banking-api",
    "typescript",
    "sdk",
    "oauth2"
  ],
  "author": "Kanishka Naik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamkanishka/tink-client"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.12",
    "jest": "^29.7.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.4",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3"
  },
  "homepage": "https://github.com/iamkanishka/tink-client#readme",
  "bugs": {
    "url": "https://github.com/iamkanishka/tink-client/issues"
  }
}
